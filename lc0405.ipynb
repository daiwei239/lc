   "outputs": [],
   "source": [
    "def judgeCircle(self, moves: str) -> bool:\n",
    "    lr= 0\n",
    "    ud= 0\n",
    "    for ss in moves:\n",
    "        if ss =='R':\n",
    "            lr+=1\n",
    "        elif ss == 'L':\n",
    "            lr-=1\n",
    "        elif ss == 'U':\n",
    "            ud -=1\n",
    "        else:\n",
    "            ud +=1\n",
    "    return lr ==0 and ud ==0\n"
   ]
  }
